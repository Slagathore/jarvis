# Copy this to .env and fill in your values
# .env is in .gitignore — never commit it

# MQTT credentials (leave empty if Mosquitto has no auth)
MQTT_USERNAME=
MQTT_PASSWORD=

# WiFi credentials for ESPHome nodes
WIFI_SSID=your_network_name
WIFI_PASSWORD=your_wifi_password

# OTA password for ESPHome over-the-air updates
OTA_PASSWORD=change_me_to_something_strong

# MQTT broker IP as seen by ESP32 nodes (your PC's local IP)
MQTT_BROKER_IP=192.168.1.X

# ── Wyze V2 Camera (wz_mini_hacks) ─────────────────────────────────────────
# Same credentials are reused for ALL Wyze cams — easier to rotate later.
# config.yaml references these via ${WYZE_RTSP_USER} / ${WYZE_RTSP_PASSWORD}.
# SECURITY NOTE: set a strong username and password here and in wz_mini.conf on
# each SD card. Do not ship a weak default.
WYZE_RTSP_USER=CHANGE_ME
WYZE_RTSP_PASSWORD=CHANGE_ME

# SSH credentials for pushing audio TO the Wyze speaker via aplay.
# wz_mini_hacks ships with `root` and a default password set in wz_mini.conf.
# If you set ENABLE_DROPBEAR="true" with key auth, leave WYZE_SSH_PASSWORD empty
# and put your private key path in WYZE_SSH_KEY_PATH instead.
WYZE_SSH_USER=root
WYZE_SSH_PASSWORD=
WYZE_SSH_KEY_PATH=
